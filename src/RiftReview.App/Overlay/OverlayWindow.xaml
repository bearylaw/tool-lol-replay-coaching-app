<Window x:Class="RiftReview.App.Overlay.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:RiftReview.App.Localization"
        xmlns:overlay="clr-namespace:RiftReview.App.Overlay"
        xmlns:viewer="clr-namespace:RiftReview.App.Viewer"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=overlay:OverlayViewModel}"
        Title="{loc:Text Overlay_Title}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Body}">
    <Window.Resources>
        <!-- Panels are opaque, so they take clicks; everything around them is transparent and lets
             clicks through to the game. -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#E60A0E14" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.GoldDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

    </Window.Resources>

    <Grid>
    <!-- The coach's drawings: under the panels, over the game; takes the mouse only in draw mode. -->
    <overlay:DrawingLayer x:Name="Ink" />

    <Grid x:Name="Root" Margin="12">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="PanelScale" />
        </Grid.LayoutTransform>

        <!-- Bottom column: bookmark list (right) and drawing tools above the control bar; stacked so
             they never cover each other or the timeline. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="1120">
        <!-- Scoreboard, while open (Tab): both teams at the current time -->
        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,8" DataContext="{Binding Scoreboard}"
                Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <Grid Margin="0,0,0,4" TextElement.FontSize="11" TextElement.Foreground="{StaticResource Brush.TextMuted}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="222" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{loc:Text Scoreboard_Kda}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="{loc:Text Scoreboard_Cs}" />
                    <TextBlock Grid.Column="3" Margin="8,0,0,0" Text="{loc:Text Scoreboard_Items}" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" Text="{loc:Text Scoreboard_Wards}" />
                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" Text="{loc:Text Scoreboard_Gold}" ToolTip="{loc:Text Scoreboard_Note}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type overlay:ScoreboardTeam}">
                            <StackPanel Margin="0,4,0,4">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="TeamName" DockPanel.Dock="Left" Width="60" FontFamily="{StaticResource Font.Display}" FontSize="14"
                                               Foreground="{StaticResource Brush.Red}" Text="{Binding Name}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Style="{StaticResource Text.Muted}" Text="{Binding Totals}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Players}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type overlay:OverlayPlayer}">
                                            <Border Margin="0,0,0,3" Padding="4,3" CornerRadius="5" Background="#F0111822">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="218" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="30" Height="30">
                                                            <ContentControl Content="{Binding Champion}" />
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="3" Padding="3,0" Background="#E60A0E14">
                                                                <TextBlock FontFamily="{StaticResource Font.Numbers}" FontSize="10" Foreground="{StaticResource Brush.GoldBright}" Text="{Binding Level}" />
                                                            </Border>
                                                            <Border Background="#99E8505B" CornerRadius="3" Visibility="{Binding IsDead, Converter={StaticResource VisibleWhen}}" />
                                                        </Grid>
                                                        <ItemsControl Margin="4,0,0,0" ItemsSource="{Binding SummonerSpells}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <ContentControl Width="14" Height="14" Margin="0,0,0,1" Content="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Margin="8,0,0,0" Width="150" VerticalAlignment="Center" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Number}" FontSize="13" Text="{Binding KdaText}" />
                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Number}" FontSize="13" Text="{Binding CsText}" />
                                                    <ItemsControl Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ContentControl Width="24" Height="24" Margin="0,0,2,0" Content="{Binding}" ToolTip="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Number}" FontSize="13" Text="{Binding WardText}" />
                                                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Number}" FontSize="13"
                                                               Foreground="{StaticResource Brush.GoldBright}" Text="{Binding ItemValueText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBlue}" Value="True">
                                    <Setter TargetName="TeamName" Property="Foreground" Value="{StaticResource Brush.Blue}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Bookmarks, while the list is open -->
        <Border Style="{StaticResource Panel}" Padding="10,8" HorizontalAlignment="Right" Margin="0,0,0,8" Width="440"
                Visibility="{Binding ShowBookmarks, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="10,4" Content="{loc:Text Bookmark_Add}" Command="{Binding AddBookmarkCommand}" />
                    <TextBlock Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" Text="{loc:Text Bookmark_Heading}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap" Text="{loc:Text Bookmark_Empty}"
                           Visibility="{Binding Bookmarks.IsEmpty, Converter={StaticResource VisibleWhen}}" />
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Bookmarks.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type overlay:BookmarkItem}">
                                <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="5" Background="#F0111822">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Padding="6,3" Content="&#xE74D;"
                                                Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                ToolTip="{loc:Text Bookmark_Delete}" AutomationProperties.Name="{loc:Text Bookmark_Delete}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Padding="6,3" Content="&#xE70F;"
                                                Command="{Binding DataContext.EditBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                ToolTip="{loc:Text Bookmark_EditTip}" AutomationProperties.Name="{loc:Text Bookmark_EditTip}" />
                                        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Ghost}" Padding="8,3" FontFamily="{StaticResource Font.Numbers}"
                                                Foreground="{StaticResource Brush.GoldBright}" Content="{Binding TimeText}"
                                                Command="{Binding DataContext.JumpToBookmarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                ToolTip="{loc:Text Bookmark_JumpTip}" />
                                        <TextBlock DockPanel.Dock="Left" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="{StaticResource Brush.GoldBright}" Text="&#xED63;" ToolTip="{loc:Text Bookmark_HasDrawing}"
                                                   Visibility="{Binding HasDrawing, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock Margin="8,0" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Text="{Binding Text}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Drawing tools, while draw mode is on -->
        <Border Style="{StaticResource Panel}" Padding="8,6" HorizontalAlignment="Center" Margin="0,0,0,8"
                DataContext="{Binding Drawing}" Visibility="{Binding IsOn, Converter={StaticResource VisibleWhen}}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Draw.Tool}" ToolTip="{loc:Text Draw_Pointer}" AutomationProperties.Name="{loc:Text Draw_Pointer}"
                             IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Pointer}" Command="{Binding ToolCommand}" CommandParameter="Pointer">
                    <Path Data="M0,0 L0,15 L4,11.5 L6.6,17.5 L9,16.5 L6.4,10.6 L11.5,10.6 Z" Fill="{StaticResource Brush.Text}" Stroke="#FF0A0E14" StrokeThickness="1"
                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </RadioButton>
                <RadioButton Style="{StaticResource Draw.Tool}" Content="&#xED63;" ToolTip="{loc:Text Draw_Pen}" AutomationProperties.Name="{loc:Text Draw_Pen}"
                             IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Pen}" Command="{Binding ToolCommand}" CommandParameter="Pen" />
                <RadioButton Style="{StaticResource Draw.Tool}" Content="&#xE7E6;" ToolTip="{loc:Text Draw_Highlighter}" AutomationProperties.Name="{loc:Text Draw_Highlighter}"
                             IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Highlighter}" Command="{Binding ToolCommand}" CommandParameter="Highlighter" />
                <RadioButton Style="{StaticResource Draw.Tool}" FontFamily="Segoe UI Symbol" Content="&#x2571;" ToolTip="{loc:Text Draw_Line}" AutomationProperties.Name="{loc:Text Draw_Line}"
                             IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Line}" Command="{Binding ToolCommand}" CommandParameter="Line" />
                <RadioButton Style="{StaticResource Draw.Tool}" FontFamily="Segoe UI Symbol" Content="&#x2197;" ToolTip="{loc:Text Draw_Arrow}" AutomationProperties.Name="{loc:Text Draw_Arrow}"
                             IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Arrow}" Command="{Binding ToolCommand}" CommandParameter="Arrow" />
                <RadioButton Style="{StaticResource Draw.Tool}" FontFamily="Segoe UI Symbol" Content="&#x25EF;" ToolTip="{loc:Text Draw_Circle}" AutomationProperties.Name="{loc:Text Draw_Circle}"
                             IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Circle}" Command="{Binding ToolCommand}" CommandParameter="Circle" />
                <RadioButton Style="{StaticResource Draw.Tool}" Content="&#xE75C;" ToolTip="{loc:Text Draw_Eraser}" AutomationProperties.Name="{loc:Text Draw_Eraser}"
                             IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Eraser}" Command="{Binding ToolCommand}" CommandParameter="Eraser" />

                <Border Width="1" Margin="8,4" Background="{StaticResource Brush.Border}" />
                <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type overlay:DrawColour}">
                            <Button Width="24" Height="24" Margin="2,0" Cursor="Hand" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.ColourCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse x:Name="Dot" Fill="{Binding Brush}" Stroke="{StaticResource Brush.Border}" StrokeThickness="2" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Brush.GoldBright}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Ellipse Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{Binding Colour.Brush}"
                         Stroke="{StaticResource Brush.GoldBright}" StrokeThickness="2" ToolTip="{loc:Text Draw_CurrentColour}" />

                <Border Width="1" Margin="8,4" Background="{StaticResource Brush.Border}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Text="{loc:Text Draw_Thickness}" />
                <Slider Width="110" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource Slider}" Minimum="2" Maximum="24"
                        SmallChange="1" LargeChange="2" Value="{Binding Thickness}" AutomationProperties.Name="{loc:Text Draw_Thickness}" />

                <Border Width="1" Margin="8,4" Background="{StaticResource Brush.Border}" />
                <Button Style="{StaticResource Button.Icon}" Padding="8,6" Content="&#xE7A7;" Command="{Binding UndoCommand}"
                        ToolTip="{loc:Text Draw_Undo}" AutomationProperties.Name="{loc:Text Draw_Undo}" />
                <Button Margin="4,0,0,0" Style="{StaticResource Button.Icon}" Padding="8,6" Content="&#xE74D;" Command="{Binding ClearCommand}"
                        ToolTip="{loc:Text Draw_Clear}" AutomationProperties.Name="{loc:Text Draw_Clear}" />
            </StackPanel>
        </Border>

        <!-- The player selected in League: their deaths, one jump at a time -->
        <Border Style="{StaticResource Panel}" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,6"
                Visibility="{Binding HasFocus, Converter={StaticResource VisibleWhen}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Brush.GoldBright}" Text="{Binding FocusText}" />
                <Button Margin="10,0,0,0" Style="{StaticResource Button.Ghost}" Padding="8,3" Content="{loc:Text Focus_Previous}"
                        Command="{Binding PreviousDeathCommand}" ToolTip="{loc:Text Focus_PreviousTip}" AutomationProperties.Name="{loc:Text Focus_PreviousTip}" />
                <Button Margin="4,0,0,0" Style="{StaticResource Button.Ghost}" Padding="8,3" Content="{loc:Text Focus_Next}"
                        Command="{Binding NextDeathCommand}" ToolTip="{loc:Text Focus_NextTip}" AutomationProperties.Name="{loc:Text Focus_NextTip}" />
            </StackPanel>
        </Border>

        <!-- Control bar, bottom centre -->
        <Border Style="{StaticResource Panel}" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" Padding="10,6" FontFamily="{StaticResource Font.Numbers}" Content="{loc:Text Overlay_Back}"
                            Command="{Binding BackCommand}" ToolTip="{loc:Text Overlay_BackTip}" />
                    <Button Margin="6,0,0,0" Style="{StaticResource Button.Primary}" Padding="14,6" Command="{Binding PlayPauseCommand}"
                            ToolTip="{loc:Text Overlay_PlayPauseTip}" AutomationProperties.Name="{loc:Text Viewer_PlayPause}">
                        <Grid>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE768;" Visibility="{Binding IsPlaying, Converter={StaticResource HiddenWhen}}" />
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE769;" Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                    </Button>
                    <Button Margin="6,0,0,0" Style="{StaticResource Button.Ghost}" Padding="10,6" FontFamily="{StaticResource Font.Numbers}" Content="{loc:Text Overlay_Forward}"
                            Command="{Binding ForwardCommand}" ToolTip="{loc:Text Overlay_ForwardTip}" />
                    <Button Margin="12,0,0,0" Style="{StaticResource Button.Icon}" Padding="8,6" Content="&#xE738;" Command="{Binding SlowerCommand}"
                            ToolTip="{loc:Text Viewer_Slower}" AutomationProperties.Name="{loc:Text Viewer_Slower}" />
                    <TextBlock Width="38" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Number}"
                               Foreground="{StaticResource Brush.GoldBright}" Text="{Binding SpeedText}" />
                    <Button Style="{StaticResource Button.Icon}" Padding="8,6" Content="&#xE710;" Command="{Binding FasterCommand}"
                            ToolTip="{loc:Text Viewer_Faster}" AutomationProperties.Name="{loc:Text Viewer_Faster}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Number}" Text="{Binding TimeText}" MinWidth="104" TextAlignment="Right" />
                    <ToggleButton Style="{StaticResource Overlay.Toggle}" IsChecked="{Binding Scoreboard.IsOpen, Mode=OneWay}" Command="{Binding Scoreboard.ToggleCommand}"
                                  ToolTip="{loc:Text Scoreboard_Tip}" AutomationProperties.Name="{loc:Text Scoreboard_Tip}">
                        <Path Data="M0,0 H16 M0,5 H16 M0,10 H16 M5,-2 V12" Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6" Margin="0,2,0,0" />
                    </ToggleButton>
                    <Button Margin="4,0,0,0" Style="{StaticResource Button.Icon}" Padding="8,6" Content="&#xE718;" Command="{Binding AddBookmarkCommand}"
                            ToolTip="{loc:Text Bookmark_AddTip}" AutomationProperties.Name="{loc:Text Bookmark_AddTip}" />
                    <ToggleButton Margin="4,0,0,0" Style="{StaticResource Overlay.Toggle}" Content="&#xE8FD;" IsChecked="{Binding ShowBookmarks, Mode=OneWay}"
                                  Command="{Binding ShowBookmarksCommand}" ToolTip="{loc:Text Bookmark_ListTip}" AutomationProperties.Name="{loc:Text Bookmark_ListTip}" />
                    <ToggleButton Margin="4,0,0,0" Style="{StaticResource Overlay.Toggle}" Content="&#xED63;" IsChecked="{Binding Drawing.IsOn, Mode=OneWay}"
                                  Command="{Binding Drawing.ToggleCommand}" ToolTip="{loc:Text Draw_Toggle}" AutomationProperties.Name="{loc:Text Draw_Toggle}" />
                    <Button Margin="4,0,0,0" Style="{StaticResource Button.Icon}" Padding="8,6" Content="&#xE8BB;" Command="{Binding CloseCommand}"
                            ToolTip="{loc:Text Overlay_CloseTip}" AutomationProperties.Name="{loc:Text Overlay_CloseTip}" />
                    <Button Margin="4,0,0,0" Style="{StaticResource Button.Icon}" Padding="8,6" Content="&#xE71A;" Command="{Binding EndReplayCommand}"
                            ToolTip="{loc:Text Overlay_EndTip}" AutomationProperties.Name="{loc:Text Overlay_EndTip}"
                            Visibility="{Binding CanEndReplay, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
                <viewer:TimelineScrubber Margin="12,0,0,0" Duration="{Binding Duration}" Position="{Binding Position}" Marks="{Binding Marks}" FocusMarks="{Binding FocusMarks}" Turrets="{Binding TurretMarks}" Bookmarks="{Binding Bookmarks.Times}" />
            </DockPanel>
        </Border>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
